# Один процесс держит игру, API, статику клиента и бота.
# Скопируй нужные секции в apps/server/.env и apps/client/.env
# (примеры лежат рядом с каждым приложением).

# ---- Сервер ----
PORT=2567
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL=1h

# Telegram: без BOT_TOKEN вход через Telegram и бот выключены.
BOT_TOKEN=
WEBAPP_URL=

# 1 — пускать в игру вне Telegram по токену dev:<имя>. В продакшене только 0.
DEV_LOGIN=1

# Без DATABASE_URL сервер работает в памяти и ничего не сохраняет.
DATABASE_URL=postgres://mmo:mmo@localhost:5432/mmo
AUTOSAVE_MS=30000

# Пригодятся, только если разносить процесс обратно на сервисы.
SERVE_CLIENT=1
RUN_BOT=1

# ---- Клиент (только для локальной разработки) ----
VITE_SERVER_URL=http://localhost:2567
