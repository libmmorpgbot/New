# ---- Telegram ----
BOT_TOKEN=123456:ABC-your-bot-token
WEBAPP_URL=https://your-domain.example/

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL=1h

# ---- Postgres ----
DATABASE_URL=postgres://mmo:mmo@localhost:5432/mmo

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- Ports ----
API_PORT=3001
GAME_PORT=2567

# ---- Client (Vite, must be prefixed with VITE_) ----
VITE_API_URL=http://localhost:3001
VITE_GAME_WS_URL=ws://localhost:2567
# Set to 1 to allow playing outside Telegram (local dev only)
VITE_DEV_LOGIN=1
DEV_LOGIN=1
