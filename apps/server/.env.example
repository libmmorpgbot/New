# Один процесс: игра, API, статика клиента и бот.
PORT=2567

# Общий секрет для JWT. В продакшене — длинная случайная строка.
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL=1h

# Telegram. Без BOT_TOKEN вход через Telegram и бот выключены.
BOT_TOKEN=
WEBAPP_URL=

# 1 — пускать в игру вне Telegram по токену dev:<имя>. В продакшене только 0.
DEV_LOGIN=1

# Без DATABASE_URL сервер работает в памяти и ничего не сохраняет.
DATABASE_URL=
AUTOSAVE_MS=30000
