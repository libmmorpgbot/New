{
  "name": "tg-mmo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:game": "pnpm --filter @tg-mmo/game-server dev",
    "dev:client": "pnpm --filter @tg-mmo/client dev",
    "dev:api": "pnpm --filter @tg-mmo/api dev",
    "dev:bot": "pnpm --filter @tg-mmo/bot dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "assets": "node tools/build-assets.mjs",
    "db:generate": "pnpm --filter @tg-mmo/db generate",
    "db:push": "pnpm --filter @tg-mmo/db push",
    "start:client": "pnpm --filter @tg-mmo/client start",
    "start:game": "pnpm --filter @tg-mmo/game-server start",
    "start:api": "pnpm --filter @tg-mmo/api start",
    "start:bot": "pnpm --filter @tg-mmo/bot start"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "pnpm": {
    "overrides": {
      "@colyseus/core": "0.16.24"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "msgpackr-extract"
    ]
  }
}
