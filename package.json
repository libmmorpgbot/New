{
  "name": "tg-mmo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:server": "pnpm --filter @tg-mmo/server dev",
    "dev:client": "pnpm --filter @tg-mmo/client dev",
    "build": "pnpm --filter @tg-mmo/client build",
    "start": "pnpm --filter @tg-mmo/server start",
    "typecheck": "pnpm -r typecheck",
    "assets": "node tools/build-assets.mjs",
    "db:generate": "pnpm --filter @tg-mmo/db generate",
    "db:push": "pnpm --filter @tg-mmo/db push",
    "check": "pnpm --filter @tg-mmo/server check:initdata && pnpm --filter @tg-mmo/server check:world"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "pnpm": {
    "overrides": {
      "@colyseus/core": "0.16.24"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "msgpackr-extract"
    ]
  }
}
